<Window x:Class="DcfToSf2.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCF → SF2"
        Height="520"
        Width="640"
        MinHeight="420"
        MinWidth="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="DCF-файл:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8" />
        <TextBox x:Name="InputFileBox"
                 Grid.Row="0" Grid.Column="1"
                 Margin="0,0,8,8"
                 VerticalContentAlignment="Center" />
        <Button Grid.Row="0" Grid.Column="2"
                Content="Обзор…"
                Padding="12,4"
                Margin="0,0,0,8"
                Click="BrowseInput_Click" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Каталог вывода:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,8" />
        <TextBox x:Name="OutputDirBox"
                 Grid.Row="1" Grid.Column="1"
                 Margin="0,0,8,8"
                 VerticalContentAlignment="Center"
                 ToolTip="Пусто — каталог входного DCF" />
        <Button Grid.Row="1" Grid.Column="2"
                Content="Обзор…"
                Padding="12,4"
                Margin="0,0,0,8"
                Click="BrowseOutput_Click" />

        <CheckBox x:Name="TwoColumnBox"
                  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                  Content="Двухколоночная раскладка пар организаций"
                  Margin="0,0,0,8" />

        <CheckBox x:Name="ForceListBox"
                  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                  Content="Перезаписать List.sf2 если уже существует"
                  Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="Игнорировать поля:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,12" />
        <TextBox x:Name="IgnoreFieldsBox"
                 Grid.Row="4" Grid.Column="1"
                 Margin="0,0,8,12"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 ToolTip="Выбранные поля и шаблоны" />
        <StackPanel Grid.Row="4" Grid.Column="2"
                    Margin="0,0,0,12">
            <Button Content="Выбрать…"
                    Padding="12,4"
                    Margin="0,0,0,4"
                    Click="SelectIgnoreFields_Click" />
            <Button Content="Список…"
                    Padding="12,4"
                    ToolTip="Показать все поля DCF, которые будут пропущены"
                    Click="ViewIgnoredFields_Click" />
        </StackPanel>
        <Button x:Name="ConvertButton"
                Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                Content="Конвертировать"
                Padding="16,8"
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                Click="Convert_Click" />

        <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                  Header="Лог"
                  Padding="4">
            <RichTextBox x:Name="LogBox"
                         IsReadOnly="true"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="true" />
        </GroupBox>
    </Grid>
</Window>
