<Window x:Class="DcfToSf2.Ui.IgnoreFieldsDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcfToSf2.Ui"
        Title="Игнорируемые поля"
        Height="560"
        Width="720"
        MinHeight="400"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Отметьте поля, которые нужно пропустить при конвертации. Группы — блоки DCF."
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Шаблоны:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right"
                        Content="Из суффиксов…"
                        Padding="10,3"
                        Margin="8,0,0,0"
                        ToolTip="Добавить *Суффикс для каждого отмеченного поля"
                        Click="AddSuffixPatterns_Click" />
                <TextBox x:Name="PatternsBox"
                         VerticalContentAlignment="Center"
                         ToolTip="Подстановки * и ?, или /regex/. Пример: *Fax, *Telex, /_Phone$/"
                         TextChanged="PatternsBox_TextChanged" />
            </DockPanel>
            <TextBlock Text="*Fax — все имена, оканчивающиеся на Fax. Совпадения подсвечиваются в дереве."
                       Foreground="Gray"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Margin="0,0,0,8" />
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Выбрать все"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Click="SelectAll_Click" />
                    <Button Content="Снять все"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Click="ClearAll_Click" />
                    <Button Content="Список…"
                            Padding="12,4"
                            ToolTip="Показать все поля, которые будут пропущены"
                            Click="ViewList_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK"
                            IsDefault="True"
                            Width="88"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Click="Ok_Click" />
                    <Button Content="Отмена"
                            IsCancel="True"
                            Width="88"
                            Padding="12,4"
                            Click="Cancel_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TreeView x:Name="FieldsTree"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Создать шаблон из ветки…"
                              Click="CreateTemplate_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:IgnoreBlockNode}"
                                          ItemsSource="{Binding Fields}">
                    <CheckBox Content="{Binding Header}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsThreeState="True"
                              PreviewMouseDown="TreeNode_PreviewMouseDown"
                              Checked="BlockCheckBox_Changed"
                              Unchecked="BlockCheckBox_Changed"
                              Indeterminate="BlockCheckBox_Changed">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPatternMatch}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Background" Value="#FFE8F0FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type local:IgnoreFieldNode}">
                    <CheckBox Content="{Binding Display}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Checked="FieldCheckBox_Changed"
                              Unchecked="FieldCheckBox_Changed"
                              PreviewMouseDown="TreeNode_PreviewMouseDown"
                              Padding="2,1">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatternMatch}" Value="True">
                                        <Setter Property="Background" Value="#FFFFF3CD" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
